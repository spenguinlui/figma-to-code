{
  "name": "figma-to-code",
  "version": "1.0.0",
  "description": "Figma → React + Tailwind component harness with pixel-accurate visual regression",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:depmap": "node scripts/build-dep-map.mjs",
    "test:visual": "node scripts/visual-regression/run.mjs --pages all",
    "test:component": "node scripts/visual-regression/assert-component.mjs --components",
    "baseline:update": "node scripts/visual-regression/run.mjs --pages all --update-baseline"
  },
  "keywords": ["figma", "react", "tailwind", "visual-regression", "claude-code"],
  "author": "spenguinlui",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "framer-motion": "^12.35.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
