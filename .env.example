# ============================================================
# Figma 設定（Design To Code）
# ============================================================
# FILE_KEY / NODE_ID 從 Figma URL 擷取：
# https://www.figma.com/design/<FILE_KEY>/<FILE_NAME>?node-id=<NODE_ID>

FIGMA_FILE_KEY=your-file-key
FIGMA_CANVAS_NODE_ID=your-canvas-node-id

# Personal Access Token — 匯出真實 SVG/PNG 用
# Figma → Settings → Account → Personal access tokens 建立
FIGMA_ACCESS_TOKEN=your-figma-token-here

# 註：Framer（Code To Framer）已棄用，相關 FRAMER_* 設定已移除。
